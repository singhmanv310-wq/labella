# Copy this file to .env (local) or set these in your hosting dashboard.
NODE_ENV=production
PORT=3000

# Your live website address, no trailing slash (used for SEO canonical tags)
SITE_URL=https://eldecomagnifico.in

# Admin login for /admin
ADMIN_EMAIL=singhmanv310@gmail.com
# Generate with:  npm run hash-password -- "YourStrongPassword"
ADMIN_PASSWORD_HASH=
# (Alternative, less secure: plain password)  ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional MongoDB Atlas connection string. Keep this secret on the server only.
MONGODB_URI=
MONGODB_DATABASE=eldeco
# Used only when MONGODB_URI is not set. Must be on a persistent disk / volume.
DATA_DIR=./data

# Optional: every new lead is POSTed here as JSON (Zapier, Make, Google Apps Script, Slack...)
WEBHOOK_URL=
# Local brochure path; the PDF is served only after a visitor submits their details.
BROCHURE_URL=/private/floorplans/eldeco-la-vida-bella-brochure.pdf
